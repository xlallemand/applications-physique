	}
	L1.visible = correct;
	if (inf) {
		A1 = {x:Infinity, y:0};
	} else {
		A1 = {x:obj.x, y:obj.y};
	}
	if (correct) {
		A2 = image(A1, L1);
	} else {
		A2 = A1;
	}
	A3 = image(A2, L2);
	with (img) {
		x = A3.x;
		y = A3.y;
	}
	rayons.graphics.clear()
		for (var j = -5; j<=5; j++) {
			var ord1 = j*5;
			if (correct) {
				incident(rayons,A1, L1, ord1,-500,  L1.x, 1);
				emergent(rayons,A2, L1, ord1, -500, L2.x, 1);
				emergent(rayons,A3, L2, ord2, -500, ret.x, 1);
			} else {
				incident(rayons,A1, L2, ord1,-500, L2.x, 1);
				emergent(rayons,A3, L2, ord1,-500, ret.x, 1);
			}
		}
	//}
function incident(mc,obj, lentille, ordo, xmin, xmax, ep) {
	with (mc.graphics) {
		var pente = (obj.y-ordo)/(obj.x-lentille.x);
		var yfin = ordo+(xmax-lentille.x)*pente;
		var ydeb = ordo+(xmin-lentille.x)*pente;
		var depart = {x:xmin, y:ydeb};
		var inci = {x:lentille.x, y:ordo};
		ss(ep).s(cou);
		if (obj.x<lentille.x) {
			moveTo(obj.x,obj.y);
			lineTo(inci.x,inci.y);
		} else if (obj.x>lentille.x) {
			moveTo(depart.x,depart.y);
			lineTo(lentille.x, ordo);
			ss(1).s('rgba(136,136,136, 0.8)');
			if (!inf) {
				lineTo(obj.x, obj.y);
			}
		}
	}
};	
function emergent(mc,img, lentille, ordo, xmin, xmax, ep, f) {
	with (mc.graphics) {
		ss(ep).s(cou);
		var pente = (img.y-ordo)/(img.x-lentille.x);
		
		var yfin = ordo+(xmax-lentille.x)*pente;
		var ydeb = ordo+(xmin-lentille.x)*pente;
		var inci = {x:lentille.x, y:ordo};
		var depart = {x:xmin, y:ydeb};
		var arriv = {x:xmax, y:yfin};
		var toto = ordo+(xmax-lentille.x)*(img.y-ordo)/(img.x-lentille.x);
		if (img.reel) {
			//image réelle
			mt(inci.x,inci.y).lt(arriv.x,arriv.y);
			//rayon(inci, arriv, f);
		} else {
			//image virtuelle
			ss(ep).s('rgba(136,136,136, 0)')
			if (img.x>xmin) {
				mt(img.x,img.y).lt(inci.x,inci.y);
				//pointille(img.x, img.y, lentille._x, ordo, 10);
			} else {
				mt(depart.x,depart.y).lt(inci.x,inci.y);
				//pointille(xmin, ydeb, lentille._x, ordo, 10);
			}
			ss(ep).s(cou).mt(inci.x,inci.y).lt(arriv.x,arriv.y);
			//rayon(inci, arriv, f);
		}
		ord2 = toto;
	}
};
		
