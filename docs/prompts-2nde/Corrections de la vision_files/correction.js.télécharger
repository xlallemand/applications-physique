function image (objet, lentille) {
	var SA = objet.x-lentille.x;
	if (SA == -lentille.foc) {
		return {x:-100000000+lentille.x, y:objet.y/lentille.foc*100000000, reel:true};
	}
	if (SA == Infinity) {
		return {x:lentille.x+lentille.foc, y:0};
	} else {
		var SA1 = SA*lentille.foc/(SA+lentille.foc);
		var gamma = SA1/SA;
		var y1 = gamma*objet.y;
		var reel = (SA1>0);
		return {x:SA1+lentille.x, y:y1, reel:reel};
	}
};
function vergence(objet, image, lentille) {
	var SA = objet.x-lentille.x;
	var SA1 = image.x-lentille.x;
	return (1/SA1-1/SA);
};
	
